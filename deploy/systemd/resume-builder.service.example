[Unit]
Description=Resume Builder API
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/resume_builder
Environment=NODE_ENV=production
EnvironmentFile=/opt/resume_builder/.env
ExecStart=/usr/bin/npm run start:prod
Restart=always
RestartSec=5
User=www-data
Group=www-data

[Install]
WantedBy=multi-user.target
